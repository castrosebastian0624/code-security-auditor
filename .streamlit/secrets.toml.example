# ==============================================================================
# Plantilla de secrets.toml para login con Clerk (st.login nativo de Streamlit)
# ==============================================================================
# Copia este archivo a .streamlit/secrets.toml (ya está en .gitignore — NUNCA
# comitees el archivo real) y completa los valores desde el dashboard de
# Clerk: Config > OAuth applications > crea una app nueva de tipo OIDC.
#
# Clerk te muestra ahí mismo el Client ID, el Client Secret y la Discovery
# URL exactos para tu instancia — cópialos tal cual los muestra el dashboard,
# no los adivines a partir de este ejemplo (la URL de abajo es orientativa).
#
# redirect_uri debe coincidir EXACTAMENTE con lo que registres como "Allowed
# redirect URI" en la app de Clerk. En local es la URL de abajo; en
# producción, la URL pública de la app + /oauth2callback.
# ==============================================================================

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"

# Genera un valor real con: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REEMPLAZA_CON_UNA_CADENA_ALEATORIA_LARGA"

client_id = "TU_CLIENT_ID_DE_CLERK"
client_secret = "TU_CLIENT_SECRET_DE_CLERK"
server_metadata_url = "https://TU-INSTANCIA.clerk.accounts.dev/.well-known/openid-configuration"

# Streamlit manda por default prompt="select_account" si no se lo pisas acá.
# Clerk lo rechaza con "invalid_request: Used unknown value '[select_account]'
# for prompt parameter" -- probado en vivo, no es hipotético. Sin este bloque
# el login nunca llega a la pantalla de Clerk.
[auth.client_kwargs]
scope = "openid email profile"
prompt = "login"
